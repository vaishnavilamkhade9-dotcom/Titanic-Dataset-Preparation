# STEP 1: IMPORT REQUIRED LIBRARIES

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings

from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split

warnings.filterwarnings('ignore')

print("Libraries imported successfully!")


# STEP 2: LOAD THE DATASET

url = "https://raw.githubusercontent.com/mwaskom/seaborn-data/master/titanic.csv"

df = pd.read_csv(url)

print("\nDATASET LOADED SUCCESSFULLY!")

# Display first and last five rows
print("\nFirst 5 Rows:")
display(df.head())

print("\nLast 5 Rows:")
display(df.tail())

# Dataset shape
print("\nNumber of Rows:", df.shape[0])
print("Number of Columns:", df.shape[1])

# Column names
print("\nColumn Names:")
print(df.columns.tolist())

# Dataset information
print("\nDataset Information:")
df.info()


# STEP 3: IDENTIFY DATA TYPES AND STATISTICS

numerical_columns = df.select_dtypes(
    include=['int64', 'float64']
).columns

categorical_columns = df.select_dtypes(
    include=['object', 'category', 'bool']
).columns

print("\nNumerical Columns:")
print(list(numerical_columns))

print("\nCategorical Columns:")
print(list(categorical_columns))

print("\nNumerical Summary Statistics:")
display(df.describe())

print("\nCategorical Summary Statistics:")
display(df.describe(include='object'))

# Target variable
target = 'survived'

print("\nTarget Variable:", target)
print(df[target].value_counts())


# STEP 4: IDENTIFY MISSING VALUES

print("\nMISSING VALUE REPORT")

missing_report = pd.DataFrame({
    'Missing Values': df.isnull().sum(),
    'Missing Percentage': df.isnull().mean() * 100
})

display(missing_report)

# Missing value visualization
plt.figure(figsize=(12, 5))

sns.heatmap(
    df.isnull(),
    cbar=False,
    cmap='viridis',
    yticklabels=False
)

plt.title("Missing Values in Titanic Dataset")
plt.xlabel("Columns")
plt.ylabel("Rows")
plt.show()


# STEP 5: HANDLE MISSING VALUES

# Create a copy of original dataset
df_clean = df.copy()

# Remove exact duplicate rows from original data
df_clean.drop_duplicates(inplace=True)

# Remove columns with excessive missing values
# and redundant information
columns_to_drop = [
    'deck', 'alive', 'class', 'who',
    'adult_male', 'embark_town',
    'name', 'ticket', 'alone'
]

df_clean.drop(
    columns=columns_to_drop,
    inplace=True,
    errors='ignore'
)

# Fill Age missing values using median
df_clean['age'] = df_clean['age'].fillna(
    df_clean['age'].median()
)

# Fill Embarked missing values using mode
df_clean['embarked'] = df_clean['embarked'].fillna(
    df_clean['embarked'].mode()[0]
)

print("\nMissing values handled successfully!")

print("\nMissing Values After Cleaning:")
print(df_clean.isnull().sum())


# STEP 6: CHECK DUPLICATES AND CONSISTENCY

print("\nDuplicate Rows Before Removal:")
print(df_clean.duplicated().sum())

df_clean.drop_duplicates(inplace=True)

print("\nDuplicate Rows After Removal:")
print(df_clean.duplicated().sum())

# Standardize categorical values
df_clean['sex'] = (
    df_clean['sex'].str.strip().str.lower()
)

df_clean['embarked'] = (
    df_clean['embarked'].str.strip().str.upper()
)

print("\nUnique Gender Values:")
print(df_clean['sex'].unique())

print("\nUnique Embarked Values:")
print(df_clean['embarked'].unique())

print("\nAge Range:")
print(df_clean['age'].min(), "-", df_clean['age'].max())

print("\nFare Range:")
print(df_clean['fare'].min(), "-", df_clean['fare'].max())


# STEP 7: EXPLORATORY DATA ANALYSIS (EDA)

print("\nSUMMARY STATISTICS:")
display(df_clean.describe())

print("\nGender Frequency:")
print(df_clean['sex'].value_counts())

print("\nPassenger Class Frequency:")
print(df_clean['pclass'].value_counts())


# GRAPH 1: HISTOGRAM OF AGE

plt.figure(figsize=(8, 5))

plt.hist(
    df_clean['age'],
    bins=20,
    edgecolor='black'
)

plt.title("Distribution of Passenger Ages")
plt.xlabel("Age")
plt.ylabel("Number of Passengers")
plt.show()


# GRAPH 2: SURVIVAL COUNT

plt.figure(figsize=(7, 5))

sns.countplot(
    data=df_clean,
    x='survived'
)

plt.title("Survival Count of Titanic Passengers")
plt.xlabel("Survival Status (0 = No, 1 = Yes)")
plt.ylabel("Number of Passengers")
plt.show()


# GRAPH 3: GENDER-WISE SURVIVAL

plt.figure(figsize=(7, 5))

sns.countplot(
    data=df_clean,
    x='sex',
    hue='survived'
)

plt.title("Gender-wise Survival Count")
plt.xlabel("Gender")
plt.ylabel("Number of Passengers")
plt.legend(title="Survived", labels=["No", "Yes"])
plt.show()


# GRAPH 4: FARE DISTRIBUTION BY CLASS

plt.figure(figsize=(8, 5))

sns.boxplot(
    data=df_clean,
    x='pclass',
    y='fare'
)

plt.title("Fare Distribution by Passenger Class")
plt.xlabel("Passenger Class")
plt.ylabel("Fare")
plt.show()


# STEP 8: ENCODE CATEGORICAL FEATURES

print("\nBefore Encoding:")
display(df_clean.head())

df_encoded = pd.get_dummies(
    df_clean,
    columns=['sex', 'embarked', 'pclass'],
    drop_first=False,
    dtype=int
)

print("\nAfter Encoding:")
display(df_encoded.head())

print("\nEncoded Column Names:")
print(df_encoded.columns.tolist())


# STEP 9: SCALE NUMERICAL FEATURES

numerical_features = [
    'age',
    'sibsp',
    'parch',
    'fare'
]

# Split indices to learn scaling parameters
# only from training data

train_indices, test_indices = train_test_split(
    df_encoded.index,
    test_size=0.2,
    random_state=42,
    stratify=df_encoded['survived']
)

# Create StandardScaler
scaler = StandardScaler()

# Fit scaler only on training data
scaler.fit(
    df_encoded.loc[train_indices, numerical_features]
)

# Apply scaling
df_encoded[numerical_features] = scaler.transform(
    df_encoded[numerical_features]
)

print("\nNumerical Features Scaled Successfully!")

print("\nScaled Numerical Features:")
display(df_encoded[numerical_features].head())


# STEP 10: SAVE PREPARED DATASET

print("\nFINAL DATASET VERIFICATION")

print("Final Dataset Shape:", df_encoded.shape)

print("\nRemaining Missing Values:")
print(df_encoded.isnull().sum().sum())

print("\nRemaining Duplicate Rows:")
print(df_encoded.duplicated().sum())

print("\nFinal Column Names:")
print(df_encoded.columns.tolist())

# Display final dataset
print("\nFINAL PREPARED DATASET:")
display(df_encoded.head(10))

# Save dataset as CSV
file_name = "Titanic_Prepared_Dataset.csv"

df_encoded.to_csv(
    file_name,
    index=False
)

print("\nDataset saved successfully!")
print("File Name:", file_name)


# DOWNLOAD CSV FILE IN GOOGLE COLAB

from google.colab import files

files.download(file_name)

